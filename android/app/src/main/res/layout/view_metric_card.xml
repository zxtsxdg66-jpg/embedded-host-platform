<?xml version="1.0" encoding="utf-8"?>
<!--
  单个环境指标卡的内容（宿主是 MetricCardView，本身已是 MaterialCardView，所以用 merge）。

  视觉规则（第二阶段 UI 方案 7.1~7.4）：
   - 指标名放在数值"上方"而不是同一行，避免"温度：26.4 ℃"把三者拉平
   - 数值 44sp、单位 16sp，约 2.75 倍差，单位不抢焦点
   - 数值加 fontFeatureSettings="tnum"（等宽数字），否则 9.9 -> 10.0 时整行会横向抖动
-->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/card_padding">

        <!-- 第一行：指标名 + 状态 Chip -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/textName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.EnvMonitor.SectionTitle"
                tools:text="温度" />

            <LinearLayout
                android:id="@+id/statusPill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingTop="3dp"
                android:paddingEnd="8dp"
                android:paddingBottom="3dp">

                <View
                    android:id="@+id/statusDot"
                    android:layout_width="@dimen/status_dot"
                    android:layout_height="@dimen/status_dot"
                    android:background="@drawable/bg_status_dot" />

                <TextView
                    android:id="@+id/textStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_caption"
                    tools:text="正常" />
            </LinearLayout>
        </LinearLayout>

        <!-- 第二行：数值 + 单位（左）与统计小字（右） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:baselineAligned="false"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/textValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:fontFeatureSettings="tnum"
                android:includeFontPadding="false"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_metric_value"
                tools:text="26.4" />

            <TextView
                android:id="@+id/textUnit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_marginBottom="5dp"
                android:includeFontPadding="false"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_metric_unit"
                tools:text="℃" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textStatsRange"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.EnvMonitor.Caption"
                    tools:text="最低 24.1   最高 28.9" />

                <TextView
                    android:id="@+id/textStatsAverage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAppearance="@style/TextAppearance.EnvMonitor.Caption"
                    tools:text="平均 26.2   样本 316" />
            </LinearLayout>
        </LinearLayout>

        <!-- 超限时才出现：把 kind/threshold 两个字段翻译成人话 -->
        <TextView
            android:id="@+id/textThreshold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/state_alarm"
            android:textSize="@dimen/text_caption"
            android:visibility="gone"
            tools:text="高于上限 35.0 ℃"
            tools:visibility="visible" />

        <com.example.envmonitor.ui.SparklineView
            android:id="@+id/sparkline"
            android:layout_width="match_parent"
            android:layout_height="@dimen/sparkline_height"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/textSeriesHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="end"
            android:text="@string/metric_series_hint"
            android:textColor="@color/text_tertiary"
            android:textSize="@dimen/text_hint" />

    </LinearLayout>
</merge>
