<?xml version="1.0" encoding="utf-8"?>
<!--
  允许明文 HTTP。

  为什么必须有这个文件：Android 9（API 28）起默认禁止明文 HTTP 流量，只允许 HTTPS。
  本项目的 PC 网关运行在局域网内、使用 http:// 与 ws://（毕设阶段不引入证书/HTTPS），
  如果不做这个配置，App 会在请求时直接失败并报 CLEARTEXT communication not permitted，
  且错误信息不直观、很容易被误判成"PC 服务没起来"或"IP 填错了"。

  安全边界：这里放开的是全局明文流量。当前场景是"手机与 PC 连同一个 Wi-Fi/热点、
  内网直连、无敏感数据、无鉴权"，属于毕设阶段可接受的取舍；若将来要把网关暴露到
  更大范围的网络，应改为 HTTPS 并收紧此配置。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
